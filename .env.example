# Copy this file to .env and edit as needed.
# docker-compose.yml reads these automatically.

# ── Device ───────────────────────────────────────────────────────────────────
# cuda  → NVIDIA GPU (default; requires the NVIDIA Container Toolkit)
# cpu   → CPU only (slow for diffusion models, fine for lama/zits/etc.)
DEVICE=cuda

# ── Model ────────────────────────────────────────────────────────────────────
# Erase models (no VRAM required beyond ~2 GB):
#   lama | ldm | zits | mat | fcf | manga | cv2 | migan
#
# Diffusion models (need 4–12 GB VRAM depending on model):
#   runwayml/stable-diffusion-inpainting
#   diffusers/stable-diffusion-xl-1.0-inpainting-0.1
#   Sanster/anything-4.0-inpainting
#   Lykon/dreamshaper-8-inpainting
#   Sanster/AnyText
MODEL=lama

# ── Interactive Segmentation (Segment Anything) ───────────────────────────────
# Always enabled in Docker. Choose the model size and which device runs it.
#
# Model options (smallest → largest / fastest → most accurate):
#   SAM2.1 : sam2_1_tiny | sam2_1_small | sam2_1_base | sam2_1_large  (recommended)
#   SAM2   : sam2_tiny   | sam2_small   | sam2_base   | sam2_large
#   SAM-HQ : sam_hq_vit_b | sam_hq_vit_l | sam_hq_vit_h
#   SAM    : vit_b | vit_l | vit_h
#   Other  : mobile_sam
#
# Device: cuda (GPU) or cpu. Running on cuda is strongly recommended when
# using any model larger than sam2_1_tiny.
INTERACTIVE_SEG_MODEL=sam2_1_tiny
INTERACTIVE_SEG_DEVICE=cuda

# ── Ports ────────────────────────────────────────────────────────────────────
# Python API backend — the container always listens on 8088.
PORT=8088

# Vite dev server — access the app with HMR at http://localhost:5173 in dev.
FRONTEND_PORT=5173
